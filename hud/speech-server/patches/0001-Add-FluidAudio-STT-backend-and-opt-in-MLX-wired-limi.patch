diff --git a/src/speech_to_speech/STT/fluidaudio_handler.py b/src/speech_to_speech/STT/fluidaudio_handler.py
new file mode 100644
index 0000000..4fc91c0
--- /dev/null
+++ b/src/speech_to_speech/STT/fluidaudio_handler.py
@@ -0,0 +1,110 @@
+"""Speech to text through FluidAudio's fluidaudio-cli daemon (Parakeet TDT on
+CoreML / the Neural Engine). It keeps the GPU and the MLX lock free for TTS,
+transcribes a short utterance in about 0.1 s, and uses a few MB of RAM, so a
+quiet spell never costs a cold model reload."""
+from __future__ import annotations
+
+import json
+import logging
+import os
+import struct
+import subprocess
+import tempfile
+import threading
+import wave
+
+import numpy as np
+from rich.console import Console
+
+from speech_to_speech.pipeline.handler_types import STTIn, STTOut
+from speech_to_speech.pipeline.messages import PartialTranscription, Transcription
+from speech_to_speech.STT.base_stt_handler import BaseSTTHandler
+
+console = Console()
+logger = logging.getLogger(__name__)
+
+
+class FluidAudioSTTHandler(BaseSTTHandler):
+    def setup(self, cli: str, model_dir: str, asr_version: str = "v3", **_unused) -> None:
+        self.argv = [cli, "--daemon", "--asr-model-dir", os.path.expanduser(model_dir),
+                     "--asr-version", asr_version]
+        self.lock = threading.Lock()
+        self.counter = 0
+        self._start()
+        self.warmup()
+
+    def _start(self) -> None:
+        self.proc = subprocess.Popen(self.argv, stdin=subprocess.PIPE,
+                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+        while True:
+            line = self.proc.stdout.readline()
+            if not line:
+                raise RuntimeError("fluidaudio-cli exited before it was ready")
+            if json.loads(line).get("type") == "ready":
+                return
+
+    def _send(self, obj: dict) -> None:
+        body = json.dumps(obj).encode()
+        self.proc.stdin.write(b"\x01" + struct.pack("<I", len(body)) + body)
+        self.proc.stdin.flush()
+
+    def _transcribe(self, audio: np.ndarray) -> str:
+        pcm = audio
+        if pcm.dtype != np.int16:
+            pcm = (np.clip(pcm, -1.0, 1.0) * 32767).astype(np.int16)
+        handle, path = tempfile.mkstemp(suffix=".wav", prefix="fluidaudio-")
+        os.close(handle)
+        with wave.open(path, "wb") as out:
+            out.setnchannels(1)
+            out.setsampwidth(2)
+            out.setframerate(16000)
+            out.writeframes(pcm.tobytes())
+        with self.lock:
+            if self.proc.poll() is not None:
+                self._start()
+            self.counter += 1
+            rid = f"t{self.counter}"
+            self._send({"id": rid, "type": "transcribe", "filePath": path,
+                        "timestamps": False, "cleanup": True})
+            while True:
+                line = self.proc.stdout.readline()
+                if not line:
+                    raise RuntimeError("fluidaudio-cli exited mid-transcription")
+                msg = json.loads(line)
+                if msg.get("id") == rid:
+                    if msg.get("type") == "error":
+                        raise RuntimeError(msg.get("message", "fluidaudio error"))
+                    return (msg.get("text") or "").strip()
+
+    def warmup(self) -> None:
+        logger.info("Warming up FluidAudioSTTHandler")
+        self._transcribe(np.zeros(16000, dtype=np.int16))
+
+    def process(self, vad_audio: STTIn):
+        text = self._transcribe(np.asarray(vad_audio.audio))
+        if getattr(vad_audio, "mode", None) == "progressive":
+            # A live, in-progress chunk of the utterance: shown, never sent on
+            # as a finished sentence (the final item carries the whole turn).
+            if text:
+                yield PartialTranscription(
+                    text=text,
+                    turn_id=vad_audio.turn_id,
+                    turn_revision=vad_audio.turn_revision,
+                )
+            return
+        if True:
+            console.print(f"[yellow]USER: {text}")
+            yield Transcription(
+                text=text,
+                turn_id=vad_audio.turn_id,
+                turn_revision=vad_audio.turn_revision,
+                speech_stopped_at_s=vad_audio.created_at_s,
+            )
+
+    def cleanup(self) -> None:
+        logger.info("Stopping FluidAudioSTTHandler")
+        try:
+            self._send({"id": "quit", "type": "quit"})
+            self.proc.wait(timeout=3)
+        except Exception:  # noqa: BLE001
+            self.proc.kill()
diff --git a/src/speech_to_speech/arguments_classes/fluidaudio_stt_arguments.py b/src/speech_to_speech/arguments_classes/fluidaudio_stt_arguments.py
