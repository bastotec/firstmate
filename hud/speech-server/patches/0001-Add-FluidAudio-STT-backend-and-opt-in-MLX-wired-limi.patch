diff --git a/src/speech_to_speech/cli.py b/src/speech_to_speech/cli.py
index b48efcf..23d8f79 100644
--- a/src/speech_to_speech/cli.py
+++ b/src/speech_to_speech/cli.py
@@ -159,10 +159,30 @@ def main() -> None:
         run_realtime_audio_client(parse_talk_arguments(command_args))
         return
 
+    _pin_models_if_asked()
     from speech_to_speech.s2s_pipeline import run_pipeline_command
 
     run_pipeline_command(command, command_args)
 
 
+def _pin_models_if_asked() -> None:
+    """Opt-in (S2S_WIRED_LIMIT_GB): keep up to that much MLX memory wired, so
+    macOS cannot page the STT and TTS weights out while the server idles. A
+    paged-out model costs ~11 s to come back on the next turn."""
+    import os
+
+    raw = os.environ.get("S2S_WIRED_LIMIT_GB", "").strip()
+    if not raw:
+        return
+    try:
+        import mlx.core as mx
+
+        limit = int(float(raw) * (1 << 30))
+        mx.set_wired_limit(limit)
+        print(f"speech-to-speech: MLX wired limit set to {raw} GB", flush=True)
+    except Exception as exc:  # noqa: BLE001
+        print(f"speech-to-speech: could not set the MLX wired limit: {exc}", flush=True)
+
+
 if __name__ == "__main__":
     main()
