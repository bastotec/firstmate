+from dataclasses import dataclass, field
+
+
+@dataclass
+class FluidAudioSTTHandlerArguments:
+    fluidaudio_cli: str = field(
+        default="/Applications/Vowen.app/Contents/Resources/bin/fluidaudio-cli",
+        metadata={"help": "The fluidaudio-cli binary (FluidAudio, CoreML on the Neural Engine)."},
+    )
+    fluidaudio_model_dir: str = field(
+        default="~/Library/Application Support/vowen/models/parakeet-tdt-0.6b-v3",
+        metadata={"help": "The Parakeet TDT CoreML model directory."},
+    )
+    fluidaudio_asr_version: str = field(
+        default="v3",
+        metadata={"help": "Parakeet version for fluidaudio-cli: v2, v3, ja or zh-cn."},
+    )
